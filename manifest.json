{
  "manifest_version": 3,
  "name": "Marmalade Tabby — AI Studio",
  "short_name": "Marmalade Tabby",
  "version": "1.0.0",
  "description": "Giao diện mèo mứt cam cho Google AI Studio: nền caro kem, khung chat khâu tay, ô nhập đầu mèo và tiếng chuông gió.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Marmalade Tabby",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://aistudio.google.com/*"],
      "css": ["fonts.css", "theme.css"],
      "js": ["chime.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["fonts/*", "img/*"],
      "matches": ["https://aistudio.google.com/*"]
    }
  ]
}
